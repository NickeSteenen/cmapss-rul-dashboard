CM_ BU_ ENGINE_REPLAY "Replays CMAPSS test data as CAN messages";
CM_ BU_ RUL_LISTENER "Decodes messages and predicts remaining useful life";
CM_ BO_ 256 "Which engine and flight this row is, and the flight conditions";
CM_ SG_ 256 counter "Row counter. Counts 0-15, then starts over at 0. All six messages of one row carry the same value";
CM_ SG_ 256 source_dataset "Which CMAPSS dataset the engine comes from";
CM_ SG_ 256 unit "Engine number within its dataset";
CM_ SG_ 256 cycle "Flight number of this engine";
CM_ SG_ 256 setting1 "Altitude: Flight altitude, thousands of feet";
CM_ SG_ 256 setting2 "Mach: Flight Mach number";
CM_ SG_ 256 setting3 "TRA: Throttle resolver angle, power lever position";
CM_ BO_ 257 "Sensors 1-4";
CM_ SG_ 257 counter "Row counter. Counts 0-15, then starts over at 0. All six messages of one row carry the same value";
CM_ SG_ 257 sensor1 "T2: Total temperature at fan inlet";
CM_ SG_ 257 sensor2 "T24: Total temperature at LPC outlet";
CM_ SG_ 257 sensor3 "T30: Total temperature at HPC outlet";
CM_ SG_ 257 sensor4 "T50: Total temperature at LPT outlet";
CM_ BO_ 258 "Sensors 5-8";
CM_ SG_ 258 counter "Row counter. Counts 0-15, then starts over at 0. All six messages of one row carry the same value";
CM_ SG_ 258 sensor5 "P2: Pressure at fan inlet";
CM_ SG_ 258 sensor6 "P15: Total pressure in bypass duct";
CM_ SG_ 258 sensor7 "P30: Total pressure at HPC outlet";
CM_ SG_ 258 sensor8 "Nf: Physical fan speed";
CM_ BO_ 259 "Sensors 9-12";
CM_ SG_ 259 counter "Row counter. Counts 0-15, then starts over at 0. All six messages of one row carry the same value";
CM_ SG_ 259 sensor9 "Nc: Physical core speed";
CM_ SG_ 259 sensor10 "epr: Engine pressure ratio, P50/P2";
CM_ SG_ 259 sensor11 "Ps30: Static pressure at HPC outlet";
CM_ SG_ 259 sensor12 "phi: Ratio of fuel flow to Ps30";
CM_ BO_ 260 "Sensors 13-17";
CM_ SG_ 260 counter "Row counter. Counts 0-15, then starts over at 0. All six messages of one row carry the same value";
CM_ SG_ 260 sensor13 "NRf: Corrected fan speed";
CM_ SG_ 260 sensor14 "NRc: Corrected core speed";
CM_ SG_ 260 sensor15 "BPR: Bypass ratio";
CM_ SG_ 260 sensor16 "farB: Burner fuel-air ratio";
CM_ SG_ 260 sensor17 "htBleed: Bleed enthalpy";
CM_ BO_ 261 "Sensors 18-21";
CM_ SG_ 261 counter "Row counter. Counts 0-15, then starts over at 0. All six messages of one row carry the same value";
CM_ SG_ 261 sensor18 "Nf_dmd: Demanded fan speed";
CM_ SG_ 261 sensor19 "PCNfR_dmd: Demanded corrected fan speed";
CM_ SG_ 261 sensor20 "W31: HPT coolant bleed";
CM_ SG_ 261 sensor21 "W32: LPT coolant bleed";
VAL_ 256 source_dataset 0 "FD001" 1 "FD002" 2 "FD003" 3 "FD004" ;
